{
  "name": "at3-stack-kit",
  "version": "1.0.0-alpha.1",
  "description": "The AI-native evolution of the T3 stack, built for edge deployment and serverless infrastructure.",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "author": "entro314-labs",
  "license": "MIT",
  "keywords": [
    "at3",
    "ait3e",
    "at3-stack",
    "ai-native",
    "nextjs",
    "react",
    "typescript",
    "tailwind",
    "supabase",
    "edge",
    "serverless",
    "starter",
    "template",
    "monorepo"
  ],
  "scripts": {
    "analyze": "ANALYZE=true pnpm build",
    "analyze:browser": "BUNDLE_ANALYZE=browser pnpm build",
    "analyze:server": "BUNDLE_ANALYZE=server pnpm build",
    "auth:audit": "node scripts/auth-audit.js",
    "auth:check": "pnpm auth:audit",
    "build": "next build",
    "build:check": "next build",
    "build:turbopack": "next build --turbopack",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:pre": "changeset pre enter",
    "changeset:pre-exit": "changeset pre exit",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "check": "pnpm lint && pnpm format:check",
    "check:fix": "pnpm lint:fix && pnpm format",
    "clean": "rm -rf .next .turbo node_modules/.cache",
    "clean:all": "rm -rf .next .turbo node_modules",
    "commit": "git add . && git-cz",
    "db:lint": "supabase db lint",
    "db:setup": "chmod +x scripts/setup-database.sh && ./scripts/setup-database.sh",
    "db:status": "supabase status",
    "db:validate": "supabase db lint && supabase status",
    "deps:check": "depcheck",
    "deps:unused": "depcheck --ignores='@types/*,eslint-*'",
    "dev": "next dev",
    "dev:bun": "bun --bun run dev",
    "dev:turbopack": "next dev --turbopack",
    "format": "oxfmt --write src packages",
    "format:check": "oxfmt --check src packages",
    "generate:types": "chmod +x scripts/generate-types.sh && ./scripts/generate-types.sh",
    "hooks:install": "lefthook install --reset-hooks-path",
    "lint": "oxlint src packages",
    "lint:fix": "oxlint --fix src packages",
    "lint:type-aware": "oxlint --type-aware --type-check src packages",
    "packages:build": "pnpm -r build",
    "packages:dev": "pnpm -r dev --parallel",
    "packages:lint": "pnpm -r lint",
    "packages:test": "pnpm -r test",
    "perf:lighthouse": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json",
    "perf:vitals": "pnpm dlx web-vitals-reporter",
    "prepare": "lefthook install --reset-hooks-path",
    "reinstall": "pnpm clean:all && pnpm install",
    "release": "pnpm build && pnpm changeset:publish",
    "release:pre": "pnpm build && pnpm changeset:pre && pnpm changeset:version && pnpm changeset:publish",
    "runtime:bun": "bun install && bun run dev",
    "security:audit": "pnpm audit --audit-level high",
    "security:check": "pnpm audit --audit-level moderate",
    "start": "next start",
    "syncpack": "syncpack update --target latest && syncpack fix --dependency-types prod,dev && syncpack format",
    "test": "vitest run",
    "test:browser": "vitest --config vitest.browser.config.ts",
    "test:ci": "vitest run --coverage && pnpm -r --filter './packages/*' --if-present test:ci",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "types:check": "pnpm run types:verify && pnpm run typecheck",
    "types:local": "supabase gen types typescript --local > src/types/database.types.ts",
    "types:remote": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.types.ts",
    "types:verify": "chmod +x scripts/verify-types.sh && ./scripts/verify-types.sh",
    "upgrade:next": "npx @next/codemod@canary upgrade latest",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "validate:full": "pnpm run validate && pnpm run test:ci && pnpm run build:check",
    "version": "pnpm changeset:version && pnpm install --frozen-lockfile"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.44",
    "@ai-sdk/azure": "^4.0.133",
    "@ai-sdk/google": "^3.0.29",
    "@ai-sdk/openai": "^3.0.29",
    "@ai-sdk/provider-utils": "^4.0.15",
    "@ai-sdk/react": "^3.0.88",
    "@ai-sdk/vercel": "^2.0.32",
    "@conform-to/react": "^1.21.3",
    "@conform-to/zod": "^1.21.3",
    "@formatjs/intl-localematcher": "^0.10.3",
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "^16.4.6",
    "@next/third-parties": "^16.4.6",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@trpc/server": "^11.31.3",
    "ai": "^6.0.86",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.564.0",
    "nanoid": "^5.1.6",
    "negotiator": "^1.1.0",
    "next": "^16.4.6",
    "next-intl": "^4.16.2",
    "next-safe-action": "^8.7.4",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.6.4",
    "recharts": "^3.7.0",
    "shadcn": "^3.8.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "trpc-to-openapi": "^3.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@faker-js/faker": "^10.3.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@swc/core": "^1.15.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "commitizen": "^4.3.1",
    "depcheck": "^1.4.7",
    "dotenv": "^17.3.1",
    "jsdom": "^28.1.0",
    "lefthook": "^2.1.1",
    "lighthouse": "^13.0.3",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "oxlint-tsgolint": "^0.13.0",
    "postcss": "^8.5.6",
    "server-only": "^0.0.1",
    "sort-package-json": "^3.6.1",
    "supabase": "^2.76.8",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "web-vitals": "^5.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not android 4.4.3"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "test",
          "chore",
          "perf",
          "ci",
          "build",
          "db",
          "api",
          "ui",
          "auth",
          "config"
        ]
      ],
      "subject-max-length": [
        2,
        "always",
        72
      ],
      "body-max-line-length": [
        2,
        "always",
        130
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
