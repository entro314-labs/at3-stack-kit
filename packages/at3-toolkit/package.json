{
  "name": "@entro314labs/at3-toolkit",
  "version": "1.0.0-alpha.1",
  "description": "Advanced development toolkit for AT3 Stack projects",
  "keywords": [
    "ai-native",
    "ait3e",
    "at3",
    "at3-stack",
    "at3t",
    "cli",
    "devtools",
    "edge",
    "linting",
    "nextjs",
    "oxc",
    "react",
    "serverless",
    "supabase",
    "tailwind",
    "testing",
    "toolkit",
    "typescript",
    "vitest"
  ],
  "homepage": "https://at3-stack.dev",
  "bugs": {
    "url": "https://github.com/entro314-labs/at3-stack-kit/issues"
  },
  "license": "MIT",
  "author": "entro314-labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/entro314-labs/at3-stack-kit.git",
    "directory": "packages/at3-toolkit"
  },
  "bin": {
    "at3-toolkit": "./dist/cli.js",
    "at3t": "./dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "configs/**/*",
    "templates/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "tsc && chmod +x dist/cli.js",
    "check": "oxlint src && oxfmt --check src",
    "check:fix": "oxlint --fix src && oxfmt --write src",
    "dev": "tsc --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish",
    "release:dry-run": "echo 'Dry run release complete'",
    "syncpack": "syncpack update --target latest && syncpack fix --dependency-types prod,dev && syncpack format",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "detect-package-manager": "^3.0.2",
    "figures": "^6.1.0",
    "fs-extra": "^11.3.3",
    "glob": "^14.0.6",
    "gradient-string": "^3.0.0",
    "semver": "^7.7.4",
    "toml": "^3.0.0",
    "validate-npm-package-name": "^7.0.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.2.3",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.0.18",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.47.0",
    "oxlint-tsgolint": "^0.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "typescript": ">=5.9.3"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=24.19.0"
  }
}
