{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "env": {
    "es2022": true,
    "node": true
  },
  "categories": {
    "correctness": "warn",
    "nursery": "off",
    "pedantic": "off",
    "perf": "warn",
    "restriction": "off",
    "style": "warn",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["src/index.ts"],
      "rules": {
        "func-style": "off",
        "id-length": "off",
        "init-declarations": "off",
        "max-statements": "off",
        "no-magic-numbers": "off",
        "no-ternary": "off",
        "sort-imports": "off",
        "sort-keys": "off"
      }
    }
  ]
}
